# Greedy Collector Configuration
# 
# Copy this file to .env and fill in values as needed.
# Repository-local .env is loaded automatically; process environment values win.
# Never commit .env or put real credentials in this example.
# 
# Ethereum uses ETHERSCAN_API_KEY and TRON uses TRON_PRO_API_KEY.
# Bitcoin requires no API key (uses free Blockstream/Mempool.space APIs).
# Litecoin requires no API key (uses the LitecoinSpace read API by default).
# Monero address resolution is local and does not use an external provider.
# 
# See README.md for configuration details.

# ==================== REQUIRED ====================

# Etherscan API key for Ethereum transaction and balance lookup
# Get free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# TronGrid API key for TRON balance and bounded transaction lookup
TRON_PRO_API_KEY=

# ==================== OPTIONAL: SOLANA RPC ====================

# Optional Solana RPC endpoint. If unset, bounded read-only queries use the
# rate-limited public mainnet endpoint. Use private RPC infrastructure in production.
SOLANA_RPC_URL=

# ==================== OPTIONAL: LITECOIN READ API ====================

# Optional HTTPS Esplora-compatible API base; defaults to LitecoinSpace.
LITECOIN_API_URL=https://litecoinspace.org/api

# ==================== OPTIONAL: BLOCKCHAIN FALLBACK ====================

# Alchemy API key for Ethereum balance fallback (not required)
# Used if Etherscan is unavailable
# Get key at https://www.alchemy.com/
ALCHEMY_API_KEY=

# ==================== OPTIONAL: SCREENING SOURCES ====================

# OpenSanctions API key (optional automated name screening; key required)
OPENSANCTIONS_API_KEY=

# URLScan.io API key (optional key for automated public domain-scan search)
URLSCAN_API_KEY=

# VirusTotal API key (optional automated domain reputation lookup; key required)
VIRUSTOTAL_API_KEY=

# ==================== DATABASE ====================

# Database URL (SQLite default works for local development)
# Change to PostgreSQL for production: postgresql://user:pass@localhost/greedy_collector
GREEDY_COLLECTOR_DATABASE_URL=sqlite:///./data/greedy_collector.db

# ==================== MONITORING ====================

# APScheduler or Celery for wallet monitoring
# Options: "apscheduler" (default, no external deps) or "celery" (requires Redis)
GREEDY_COLLECTOR_MONITORING_BACKEND=apscheduler

# How often to check Ethereum wallets (minutes)
GREEDY_COLLECTOR_ETH_MONITOR_MINUTES=10

# How often to check Bitcoin wallets (minutes)
GREEDY_COLLECTOR_BTC_MONITOR_MINUTES=20

# How often to check TRON wallets (minutes)
GREEDY_COLLECTOR_TRON_MONITOR_MINUTES=10

# How often to check Solana accounts (minutes)
GREEDY_COLLECTOR_SOLANA_MONITOR_MINUTES=10

# How often to check Litecoin wallets (minutes)
GREEDY_COLLECTOR_LTC_MONITOR_MINUTES=20

# ==================== OPTIONAL: CELERY SCALE TIER ====================

# Redis URL for Celery (only used if MONITORING_BACKEND=celery)
GREEDY_COLLECTOR_REDIS_URL=redis://localhost:6379/0

# ==================== OPTIONAL: NEO4J GRAPH MIRROR ====================

# Graph storage backend
# Options: "sqlite" (default, authoritative) or "neo4j" (optional mirror)
GREEDY_COLLECTOR_GRAPH_BACKEND=sqlite

# Neo4j connection details (only used if GRAPH_BACKEND=neo4j)
GREEDY_COLLECTOR_NEO4J_URL=http://localhost:7474
GREEDY_COLLECTOR_NEO4J_USER=neo4j
GREEDY_COLLECTOR_NEO4J_PASSWORD=

# ==================== APPLICATION ====================

# Request timeout for external API calls (seconds)
GREEDY_COLLECTOR_TIMEOUT=20

# User-Agent string for requests to external APIs
SEC_USER_AGENT=Greedy Collector research contact@example.invalid

# Optional Broad Discovery. Enable storage only with appropriate Brave storage rights.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_ALLOWED=false

# Optional Tavily Basic Search: free keyless access by default, subject to provider limits.
# A configured key takes precedence. Free keys require no payment card.
TAVILY_API_KEY=
TAVILY_KEYLESS_ENABLED=true
